EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# NVIDIA API key (local only)
NVIDIA_API_KEY=

# Etsy Open API v3（可选；不填则跳过 Etsy，结果写 etsy_status: disabled）
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# 香港服务器（故事 8；服务器买好后填写。未填 CURIO_SERVER_URL 则同步写 sync_status: disabled）
CURIO_SERVER_URL=
CURIO_ADMIN_TOKEN=
CURIO_SSH_HOST=
# 以下选填，留空用默认值（注释只能单独成行，不能写在值后面）
# 默认 /opt/curiobject
CURIO_REMOTE_DIR=
# 默认 /var/lib/curiobject/server.db
CURIO_REMOTE_DB=
# 默认 uv
CURIO_REMOTE_UV=
# 默认 <CURIO_REMOTE_DIR>/server/.venv/bin/python
CURIO_REMOTE_PYTHON=
